<span class="arn-controls">
  {{#if system.source.page}}<a data-action="openPage" data-tooltip="Open handbook page {{system.source.page}}"><i class="fa-solid fa-book-open"></i></a>{{/if}}
  {{#if @root.editable}}{{#if equip}}<a data-action="itemEquip" class="{{#if system.equipped}}on{{/if}}" data-tooltip="{{#if system.equipped}}Equipped{{else}}Not equipped{{/if}}"><i class="fa-solid fa-shield-halved"></i></a>{{/if}}{{/if}}
  {{#if @root.editable}}
  {{#if system.needsChoice}}<a class="arn-choose" data-action="itemChoose" data-tooltip="Pick the attribute its bonus goes to (no bonus until you do)"><i class="fa-solid fa-dumbbell"></i> Choose attribute</a>{{/if}}
  {{#if system.needsOption}}<a class="arn-choose" data-action="itemChooseOption" data-tooltip="Pick its {{#if system.optionChoice.label}}{{system.optionChoice.label}}{{else}}option{{/if}}: there's room for one more, and nothing counts until it's picked"><i class="fa-solid fa-list-check"></i> Choose {{#if system.optionChoice.label}}{{system.optionChoice.label}}{{else}}option{{/if}}</a>{{else if system.optionChoice.options.length}}<a data-action="itemChooseOption" data-tooltip="Change its {{#if system.optionChoice.label}}{{system.optionChoice.label}}{{else}}option{{/if}} picks"><i class="fa-solid fa-list-check"></i></a>{{/if}}
  {{#if system.needsWeapon}}<a class="arn-choose" data-action="itemChooseWeapon" data-tooltip="Pick the weapon it's for (its bonuses are reminders until you do)"><i class="fa-solid fa-khanda"></i> Choose weapon</a>{{/if}}
  <a data-action="itemEdit" data-tooltip="Edit"><i class="fa-solid fa-pen"></i></a>
  <a data-action="itemDelete" data-tooltip="Delete"><i class="fa-solid fa-trash"></i></a>
  {{/if}}
</span>
