<div class="arn-card">
  <header class="arn-card-title">{{title}}{{#if modeLabel}} <span class="arn-mode" {{#if whyLabel}}data-tooltip="{{whyLabel}}"{{/if}}>{{modeLabel}}</span>{{/if}}</header>
  <div class="arn-card-dice">
    {{#each dice}}<span class="arn-die {{#if dropped}}dropped{{/if}}">{{result}}</span>{{/each}}
    {{#each parts}}<span class="arn-part">{{value}} <small>{{label}}</small></span>{{/each}}
  </div>
  <div class="arn-card-result">
    <span class="arn-total">{{total}}</span>
    {{#if target}}<span class="arn-target">vs {{target}}</span>{{/if}}
  </div>
  {{#if whyLabel}}<div class="arn-why">{{whyLabel}}</div>{{/if}}
  <div class="arn-luck-burned" {{#unless luckBurned}}hidden{{/unless}}>+{{luckBurned}} Luck burned</div>
  {{#if outcomeLabel}}<div class="arn-outcome {{outcome}}">{{outcomeLabel}}</div>{{/if}}
  {{#if targets.length}}
  <ul class="arn-targets">
    {{#each targets}}<li data-target-ac="{{ac}}"><span>{{name}} <small>AC {{ac}}</small></span><span class="arn-target-result {{outcome}}">{{label}}</span></li>{{/each}}
  </ul>
  {{/if}}
  {{#if notes.length}}<ul class="arn-notes">{{#each notes}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
  <div class="arn-footer">{{{footer}}}</div>
  {{#if canSecond}}<div class="arn-second arn-dmg-buttons">{{#if secondAdv}}<button type="button" class="arn-second-die" data-dir="1" data-tooltip="{{#if cancels}}Cancels the Disadvantage: the first die counts{{else}}{{#if rollUnder}}Roll a second d20 and keep the lower (roll under your Luck){{else}}Roll a second d20 and keep the higher (flanking, Running Shot, the GM's call){{/if}}{{/if}}"><i class="fa-solid fa-angles-up"></i> Advantage</button>{{/if}}{{#if secondDis}}<button type="button" class="arn-second-die" data-dir="-1" data-tooltip="{{#if paDis}}The Disadvantage on the card applies: Power Attack doesn't count on this attack{{else}}{{#if cancels}}Cancels the Advantage: the first die counts{{else}}{{#if rollUnder}}Roll a second d20 and keep the higher (roll under your Luck){{else}}Roll a second d20 and keep the lower (cover, long range, the GM's call){{/if}}{{/if}}{{/if}}"><i class="fa-solid fa-angles-down"></i> {{#if paDis}}Disadvantage applies (Power Attack off){{else}}Disadvantage{{/if}}</button>{{/if}}</div>{{/if}}
  {{#if canBurn}}<button type="button" class="arn-burn"><i class="fa-solid fa-clover"></i> Burn Luck</button>{{/if}}
</div>
